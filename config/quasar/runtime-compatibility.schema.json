{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./runtime-compatibility.schema.json",
  "title": "Quasar runtime-compatibility boundary map",
  "description": "Schema for config/quasar/runtime-compatibility.json — the per-file static compatibility boundary for Quasar demo mode, enforced by scripts/check-quasar-runtime-compatibility.mjs.",
  "type": "object",
  "required": ["updatedAt", "phase", "target", "summary", "demoCriticalPaths", "allowedStatuses", "submissionReadyRule"],
  "properties": {
    "$schema": { "type": "string" },
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "phase": { "type": "integer", "minimum": 0 },
    "target": { "type": "string" },
    "summary": { "type": "string" },
    "allowedStatuses": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "submissionReadyRule": { "type": "string" },
    "demoCriticalPaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "surface", "status", "reason"],
        "properties": {
          "path": { "type": "string" },
          "surface": { "type": "string" },
          "status": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
