{
  "name": "@redditech/agent-protocol",
  "version": "0.2.0",
  "description": "Open RAP Assurance primitives for paid agent work: receipts, policy decisions, fixtures, and local conformance helpers.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./receipt-v2": {
      "types": "./dist/receipt-v2.d.ts",
      "import": "./dist/receipt-v2.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js"
    },
    "./ai-catalog": {
      "types": "./dist/ai-catalog.d.ts",
      "import": "./dist/ai-catalog.js"
    },
    "./provider-trust": {
      "types": "./dist/provider-trust.d.ts",
      "import": "./dist/provider-trust.js"
    },
    "./discovery-source": {
      "types": "./dist/discovery-source.d.ts",
      "import": "./dist/discovery-source.js"
    },
    "./evidence-archive": {
      "types": "./dist/evidence-archive.d.ts",
      "import": "./dist/evidence-archive.js"
    },
    "./source-diagnostics": {
      "types": "./dist/source-diagnostics.d.ts",
      "import": "./dist/source-diagnostics.js"
    },
    "./source-trust-conformance-matrix": {
      "types": "./dist/source-trust-conformance-matrix.d.ts",
      "import": "./dist/source-trust-conformance-matrix.js"
    },
    "./attestation-reputation": {
      "types": "./dist/attestation-reputation.d.ts",
      "import": "./dist/attestation-reputation.js"
    },
    "./audd-rail-config": {
      "types": "./dist/audd-rail-config.d.ts",
      "import": "./dist/audd-rail-config.js"
    },
    "./payment-records": {
      "types": "./dist/payment-records.d.ts",
      "import": "./dist/payment-records.js"
    },
    "./agent-stack-fixtures": {
      "types": "./dist/agent-stack-fixtures.d.ts",
      "import": "./dist/agent-stack-fixtures.js"
    },
    "./quasar-registry-compatibility": {
      "types": "./dist/quasar-registry-compatibility.d.ts",
      "import": "./dist/quasar-registry-compatibility.js"
    },
    "./mpp-tempo-receipt-shapes": {
      "types": "./dist/mpp-tempo-receipt-shapes.d.ts",
      "import": "./dist/mpp-tempo-receipt-shapes.js"
    },
    "./okf-adapter": {
      "types": "./dist/okf-adapter.d.ts",
      "import": "./dist/okf-adapter.js"
    },
    "./okf-conformance": {
      "types": "./dist/okf-conformance.d.ts",
      "import": "./dist/okf-conformance.js"
    },
    "./okf-instruction-safety": {
      "types": "./dist/okf-instruction-safety.d.ts",
      "import": "./dist/okf-instruction-safety.js"
    },
    "./onboarding-analyser-handoff": {
      "types": "./dist/onboarding-analyser-handoff.d.ts",
      "import": "./dist/onboarding-analyser-handoff.js"
    },
    "./onboarding-state-machine": {
      "types": "./dist/onboarding-state-machine.d.ts",
      "import": "./dist/onboarding-state-machine.js"
    },
    "./repo-explorer-evidence-manifest": {
      "types": "./dist/repo-explorer-evidence-manifest.d.ts",
      "import": "./dist/repo-explorer-evidence-manifest.js"
    },
    "./ranking-explainability": {
      "types": "./dist/ranking-explainability.d.ts",
      "import": "./dist/ranking-explainability.js"
    },
    "./browser-wallet-approval": {
      "types": "./dist/browser-wallet-approval.d.ts",
      "import": "./dist/browser-wallet-approval.js"
    },
    "./adl": {
      "types": "./dist/adl.d.ts",
      "import": "./dist/adl.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist dist-tests",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-tests/*.test.js",
    "example:ard:no-spend": "npm run build && node examples/ard-no-spend-demo.mjs",
    "example:interpretation-guide": "npm run build && node examples/interpretation-guide-scenarios.mjs",
    "conformance": "node ../../scripts/run-public-conformance.mjs",
    "check:exports": "node scripts/check-package-exports.mjs",
    "check:artifacts": "node ../../scripts/check-package-artifact-contents.mjs --dir packages/agent-protocol",
    "prepublishOnly": "npm run build && node scripts/check-package-exports.mjs && npm run check:artifacts",
    "release:dry-run": "npm run clean && npm run build && npm test && node scripts/check-package-exports.mjs && npm run check:artifacts && npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  }
}
