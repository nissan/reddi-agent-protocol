{
  "name": "@redditech/provider-kit",
  "version": "0.4.1",
  "description": "Run your own paid, per-token priced provider on Reddi Agent Protocol: one config file, one command, any OpenAI-compatible model or Claude.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nissan/reddi-agent-protocol.git",
    "directory": "packages/provider-kit"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "rap-provider": "dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/tests",
    "examples",
    "!examples/**/*.private.txt",
    "Dockerfile",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check:artifacts": "node ../../scripts/check-package-artifact-contents.mjs --dir packages/provider-kit",
    "release:dry-run": "npm run clean && npm test && npm run check:artifacts && npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.7.0",
    "@redditech/agent-protocol": "file:../agent-protocol",
    "@redditech/x402-solana": "file:../x402-solana",
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "typescript": "^5"
  }
}
