# Active network profile: devnet | local-surfpool | mainnet
# NETWORK_PROFILE is the only true runtime selector: it is not NEXT_PUBLIC_-prefixed,
# so Next never inlines it and a value set on a running server always wins server-side.
NETWORK_PROFILE=devnet
# Optional build-time selector. Whenever it is present in the build environment Next
# freezes its value into BOTH the server and client bundles, so setting it only at
# runtime takes effect solely when the build had no profile at all. It is also the
# lowest-precedence key (see docs/NETWORK-PROFILES.md).
# NEXT_PUBLIC_NETWORK_PROFILE=devnet
# next.config.ts derives NEXT_PUBLIC_BUILD_NETWORK_PROFILE from the build-time profile
# and it is the browser's source of truth. Do not set it by hand.

# Program target: quasar | legacy-anchor (default when unset: legacy-anchor)
# The demo target is the Quasar program set per config/quasar/deployments.json
# (cutover 2026-05-06). Set this explicitly in every deployed environment;
# quasar is only honored on the devnet profile.
NEXT_PUBLIC_DEMO_PROGRAM_TARGET=quasar

# Solana RPC endpoint override (falls back to profile default)
# NEXT_PUBLIC_RPC_ENDPOINT=https://your-rpc-endpoint.rpcfast.com

# Escrow program id override (falls back to profile default)
# NEXT_PUBLIC_ESCROW_PROGRAM_ID=<program-pubkey>

# PER RPC override (falls back to profile default)
# NEXT_PUBLIC_PER_RPC=https://devnet-tee.magicblock.app

# Jupiter Developer Platform API key (https://developers.jup.ag)
JUPITER_API_KEY=<from developers.jup.ag — never commit a real key>

# Jupiter Swap V2 API base (default: https://api.jup.ag/swap/v2)
JUPITER_API_BASE=https://api.jup.ag/swap/v2

# Auto-swap slippage in basis points (default: 50 = 0.5%)
JUPITER_SLIPPAGE_BPS=50

# Torque Protocol — programmable retention layer (https://platform.torque.so)
TORQUE_API_TOKEN=<from platform.torque.so>
TORQUE_PROJECT_ID=<created via Torque MCP after signup>
TORQUE_LEADERBOARD_CAMPAIGN_ID=<created via Torque MCP>
TORQUE_REBATE_CAMPAIGN_ID=<created via Torque MCP>
TORQUE_API_BASE=https://api.torque.so
