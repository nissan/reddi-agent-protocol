# Active network profile: devnet | local-surfpool | mainnet
# NETWORK_PROFILE is the only true runtime selector: it is not NEXT_PUBLIC_-prefixed,
# so Next never inlines it and a value set on a running server always wins server-side.
NETWORK_PROFILE=devnet
# Optional build-time selector. Whenever it is present in the build environment Next
# freezes its value into BOTH the server and client bundles, so setting it only at
# runtime takes effect solely when the build had no profile at all. It is also the
# lowest-precedence key (see docs/NETWORK-PROFILES.md).
# NEXT_PUBLIC_NETWORK_PROFILE=devnet
# next.config.ts derives NEXT_PUBLIC_BUILD_NETWORK_PROFILE from the build-time profile
# and it is the browser's source of truth. Do not set it by hand.
# Devnet program-id overrides are ignored unless this server-side build setting is
# explicitly true; next.config.ts mirrors it into NEXT_PUBLIC_BUILD_ALLOW_UNSAFE_ESCROW_OVERRIDE.
# Do not set a runtime NEXT_PUBLIC_ALLOW_UNSAFE_ESCROW_OVERRIDE flag.
# ALLOW_UNSAFE_ESCROW_OVERRIDE=false

# Program target: quasar | legacy-anchor (default when unset: legacy-anchor)
# Set this explicitly in every deployed environment.
NEXT_PUBLIC_DEMO_PROGRAM_TARGET=legacy-anchor
#
# Quasar is an experimental opt-in, never a default. The recorded Quasar devnet
# deployment is blocked (config/quasar/deployments.json, submissionReady: false)
# because it predates the job-binding rework, so `quasar` is refused on mainnet and
# blocked on devnet. It is usable only on the local Surfpool lane, and only when both
# of the following hold:
#   NETWORK_PROFILE=local-surfpool
#   NEXT_PUBLIC_ESCROW_PROGRAM_ID / NEXT_PUBLIC_REGISTRY_PROGRAM_ID /
#   NEXT_PUBLIC_REPUTATION_PROGRAM_ID / NEXT_PUBLIC_ATTESTATION_PROGRAM_ID all set to
#   four distinct valid program ids deployed from the current in-repo Quasar sources.
# The profile's own RPC is already loopback; any NEXT_PUBLIC_RPC_ENDPOINT override must
# stay loopback, and the Surfpool SDK lane supplies both the dynamic loopback port and
# the four ids itself. See docs/SURFPOOL-QUASAR-CRITICAL-SDK-LANE.md and
# docs/NETWORK-PROFILES.md. Selecting `quasar` implies no deployment or submission
# readiness.
# NEXT_PUBLIC_DEMO_PROGRAM_TARGET=quasar

# Solana RPC endpoint override (falls back to profile default)
# NEXT_PUBLIC_RPC_ENDPOINT=https://your-rpc-endpoint.rpcfast.com

# Program id overrides, one per program (each falls back to the registered id for
# the resolved target). A value that does not base58-decode to 32 bytes is rejected;
# on devnet these are ignored unless the build set ALLOW_UNSAFE_ESCROW_OVERRIDE=true.
# Either way the resolver records the discarded override in knownGaps rather than
# crashing; rejected values make the selected profile non-submission-ready. See
# docs/NETWORK-PROFILES.md.
# NEXT_PUBLIC_ESCROW_PROGRAM_ID=<program-pubkey>
# NEXT_PUBLIC_REGISTRY_PROGRAM_ID=<program-pubkey>
# NEXT_PUBLIC_REPUTATION_PROGRAM_ID=<program-pubkey>
# NEXT_PUBLIC_ATTESTATION_PROGRAM_ID=<program-pubkey>

# PER RPC override (falls back to profile default)
# NEXT_PUBLIC_PER_RPC=https://devnet-tee.magicblock.app

# Jupiter Developer Platform API key (https://developers.jup.ag)
JUPITER_API_KEY=<from developers.jup.ag — never commit a real key>

# Jupiter Swap V2 API base (default: https://api.jup.ag/swap/v2)
JUPITER_API_BASE=https://api.jup.ag/swap/v2

# Auto-swap slippage in basis points (default: 50 = 0.5%)
JUPITER_SLIPPAGE_BPS=50

# Torque Protocol — programmable retention layer (https://platform.torque.so)
TORQUE_API_TOKEN=<from platform.torque.so>
TORQUE_PROJECT_ID=<created via Torque MCP after signup>
TORQUE_LEADERBOARD_CAMPAIGN_ID=<created via Torque MCP>
TORQUE_REBATE_CAMPAIGN_ID=<created via Torque MCP>
TORQUE_API_BASE=https://api.torque.so
