# Copy to .env.local for local runs. On Vercel, mark every secret as Sensitive.
PROVIDERS_NETWORK=devnet
PROVIDERS_PUBLIC_ORIGIN=https://providers.example.com
PROVIDER_KIT_DATABASE_URL=
CRON_SECRET=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Alert email for `alert: true` log events (lib/alerts.ts); all three or none. The key is Sensitive.
PROVIDER_ALERT_RESEND_API_KEY=
PROVIDER_ALERT_EMAIL_TO=
PROVIDER_ALERT_EMAIL_FROM=
# Mainnet only: the RPC endpoint (it carries the provider key, so Sensitive).
SOLANA_RPC_URL=
HUMANISER_WALLET=
HUMANISER_KEYPAIR=
HUMANISER_PROMPT=
WRITING_STYLE_WALLET=
WRITING_STYLE_KEYPAIR=
WRITING_STYLE_PROMPT=
SCRIPT_WRITER_WALLET=
SCRIPT_WRITER_KEYPAIR=
SCRIPT_WRITER_PROMPT=
