{
  "name": "RAP Writing Style",
  "description": "Checks and rewrites a draft against a house style guide: tone, word choice, headings and structure, with the facts unchanged.",
  "network": "solana-mainnet-beta",
  "wallet": "REPLACE_WITH_THE_WRITING_STYLE_WALLET",
  "publicUrl": "https://REPLACE_WITH_THE_WRITING_STYLE_ADDRESS",
  "model": "claude-sonnet-5-5",
  "upstream": {
    "provider": "anthropic",
    "apiKeyEnv": "ANTHROPIC_API_KEY",
    "effort": "low",
    "thinking": "off",
    "mock": false
  },
  "price": {
    "currency": "USDC",
    "inputPerMillion": "2.6",
    "outputPerMillion": "13",
    "maxOutputTokens": 3000
  },
  "capacity": {
    "requestsPerMinute": 30,
    "requestsPerDay": 200,
    "cooldownSeconds": 60
  },
  "budgets": {
    "enabled": false
  },
  "listing": {
    "capabilities": {
      "taskTypes": [
        "writing",
        "editing"
      ]
    }
  },
  "systemPromptFile": "writing-style.prompt.private.txt",
  "keypairPath": "~/.config/solana/rap/writing-style.json",
  "replayFile": ".rap-provider/writing-style/accepted.log"
}
