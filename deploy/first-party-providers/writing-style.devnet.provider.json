  "sessions": {
    "file": ".rap-provider/writing-style/sessions.jsonl"
  },
  "budgets": {
    "enabled": true,
    "acceptedJudges": [
      "9Zv4HWNRt5WzSjBkbmJnGPtAT7vrcG8NxTzcd2iGF576"
    ]
  },
  "listing": {
    "appUrl": "https://app.agent-protocol.reddi.tech",
    "capabilities": {
      "taskTypes": [
        "writing",
        "editing"
      ]
    }
  },
  "systemPromptFile": "writing-style.prompt.private.txt",
  "keypairPath": "~/.config/solana/rap/writing-style-devnet.json",
  "replayFile": ".rap-provider/writing-style/accepted.log"
